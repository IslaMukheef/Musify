<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musify.Views.LibraryView"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="black">

    <Grid RowDefinitions="Auto, *, auto"
                 ColumnDefinitions="*,*">
        <CollectionView Grid.Row="0"
                        Grid.ColumnSpan="2"
                        x:Name="LibraryListView"
                        ItemsSource="{Binding playlist}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView>
                        <Border BackgroundColor="#332433" Margin="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnViewPlayListTapped" NumberOfTapsRequired="1"></TapGestureRecognizer>
                            </Border.GestureRecognizers>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border  
                                        Stroke="White"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 20"
                                        Margin="5,5,10,5" 
                                        Grid.RowSpan="2"
                                    Grid.Column="0">
                                    <Image Source="{Binding PlayListImage}"
                                           Aspect="AspectFit"
                                           WidthRequest="80"
                                           HeightRequest="60"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1"
                                       TextColor="White"
                                       Text="{Binding PlayListName}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       Grid.Row="0"
                                       HorizontalOptions="Start"/>
                                
                                <Label Grid.Row="1" TextColor="White"
                                       Grid.Column="1"
                                       VerticalOptions="Start"
                                       Text="{Binding CreatorName}"
                                       FontAttributes="Italic"
                                       />
                                 
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
         <Border Grid.Row="2"
         Grid.ColumnSpan="2"
         BackgroundColor="AliceBlue"
         Margin="10"
         WidthRequest="100"
         HeightRequest="45">
     <Label Text="New" TextColor="Black"
            Grid.Column="0"
            Margin="10"
            FontAttributes="Bold"
            VerticalOptions="Start"
            HorizontalOptions="Center"
           />
     <Border.StrokeShape>
         <RoundRectangle CornerRadius="14"/>
     </Border.StrokeShape>
     <Border.GestureRecognizers>
         <TapGestureRecognizer Tapped="OnNewTapped" NumberOfTapsRequired="1"></TapGestureRecognizer>
     </Border.GestureRecognizers>
 </Border>

       
     
    </Grid>
</ContentPage>
