<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Musify.Views.Home"
             Title="Home"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,48,20,20"
                                 Spacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Home"
                           TextColor="White"
                           FontSize="28"
                           FontAttributes="Bold" />
                </VerticalStackLayout>

                <SearchBar x:Name="HomeSearchBar"
                           Placeholder="Search songs or artists"
                           BackgroundColor="#121212"
                           TextColor="White"
                           PlaceholderColor="#8C8C8C"
                           Focused="OnHomeSearchBarFocused"
                           HorizontalOptions="Fill" />

                <VerticalStackLayout x:Name="GetStartedSection"
                                     Spacing="12">
                    <Label Text="Explore"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                        <VerticalStackLayout x:Name="ChillMixCard"
                                             Grid.Column="0"
                                             Spacing="4">
                            <Border BackgroundColor="#5B5B5B"
                                    StrokeThickness="0"
                                    HeightRequest="140"
                                    Margin="0,0,0,4"> <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Image x:Name="FirstPlaylistImage"
                                       Aspect="AspectFill" />
                            </Border>

                            <Label x:Name="FirstPlaylistTitle"
                                   Text="Chill Mix"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold" />

                            <Label x:Name="FirstPlaylistSubtitle"
                                   Text="Relaxed songs for studying"
                                   TextColor="#B8B8B8"
                                   FontSize="13" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="TopTracksCard"
                                             Grid.Column="1"
                                             Spacing="4">
                            <Border BackgroundColor="#5B5B5B"
                                    StrokeThickness="0"
                                    HeightRequest="140"
                                    Margin="0,0,0,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Image x:Name="SecondPlaylistImage"
                                       Aspect="AspectFill" />
                            </Border>

                            <Label x:Name="SecondPlaylistTitle"
                                   Text="Top Tracks"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold" />

                            <Label x:Name="SecondPlaylistSubtitle"
                                   Text="Popular songs from your library"
                                   TextColor="#B8B8B8"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="LibrarySection"
                                     Spacing="12">
                    <Label Text="Discover something new"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="14"
                          RowSpacing="16">
                        <VerticalStackLayout x:Name="WorkoutPlaylistCard"
                                             Grid.Column="0"
                                             Spacing="4">
                            <Border BackgroundColor="#5B5B5B"
                                    StrokeThickness="0"
                                    HeightRequest="140"
                                    Margin="0,0,0,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Image x:Name="FirstSongImage"
                                       Aspect="AspectFill" />
                            </Border>

                            <Label x:Name="FirstSongTitle"
                                   Text="Indie Finds"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold" />

                            <Label x:Name="FirstSongSubtitle"
                                   Text="Fresh tracks to check out"
                                   TextColor="#B8B8B8"
                                   FontSize="13" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="LateNightMixCard"
                                             Grid.Column="1"
                                             Spacing="4">
                            <Border BackgroundColor="#5B5B5B"
                                    StrokeThickness="0"
                                    HeightRequest="140"
                                    Margin="0,0,0,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Image x:Name="SecondSongImage"
                                       Aspect="AspectFill" />
                            </Border>

                            <Label x:Name="SecondSongTitle"
                                   Text="Artist Spotlight"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold" />

                            <Label x:Name="SecondSongSubtitle"
                                   Text="New artists worth exploring"
                                   TextColor="#B8B8B8"
                                   FontSize="13" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1"
                                             Grid.Column="0"
                                             Spacing="4">
                            <Border BackgroundColor="#5B5B5B"
                                    StrokeThickness="0"
                                    HeightRequest="140"
                                    Margin="0,0,0,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Image x:Name="ThirdSongImage"
                                       Aspect="AspectFill" />
                            </Border>

                            <Label x:Name="ThirdSongTitle"
                                   Text="Song title"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold" />

                            <Label x:Name="ThirdSongSubtitle"
                                   Text="Artist name"
                                   TextColor="#B8B8B8"
                                   FontSize="13" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1"
                                             Grid.Column="1"
                                             Spacing="4">
                            <Border BackgroundColor="#5B5B5B"
                                    StrokeThickness="0"
                                    HeightRequest="140"
                                    Margin="0,0,0,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Image x:Name="FourthSongImage"
                                       Aspect="AspectFill" />
                            </Border>

                            <Label x:Name="FourthSongTitle"
                                   Text="Song title"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold" />

                            <Label x:Name="FourthSongSubtitle"
                                   Text="Artist name"
                                   TextColor="#B8B8B8"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <toolkit:MediaElement x:Name="GlobalMediaElement" 
                              ShouldAutoPlay="True" 
                              ShouldShowPlaybackControls="False"
                              IsVisible="False" />
    </Grid>
</ContentPage>
