<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musify.Views.LibraryView"
             xmlns:models="clr-namespace:Musify.Models"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" Padding="20,48,20,10">
        
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" VerticalOptions="Center" Margin="0,0,0,10">
            <Label Text="Playlists" 
                   TextColor="White" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center"/>
            
            <ImageButton Grid.Column="1"
                         Source="plus_icon.png"
                         Clicked="OnNewClicked"
                         WidthRequest="32"
                         HeightRequest="32"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center"
                         Margin="0,0,10,0"/>

            <ImageButton Grid.Column="2"
                         Source="edit_icon.png" Clicked="OnPlayListEditClicked"
                         WidthRequest="32"
                         HeightRequest="32"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center">
            </ImageButton>
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding playlist}" SelectionMode="Single" SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" Margin="0,0,0,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView>
                        <Border BackgroundColor="#332433" Margin="10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnViewPlayListTapped" NumberOfTapsRequired="1"/></Border.GestureRecognizers>
                            <Grid RowSpacing="0"> 
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 20" Margin="5,5,10,5" Grid.RowSpan="2" Grid.Column="0">
                                    <Image Source="{Binding PlayListImage}" Aspect="AspectFit" WidthRequest="80" HeightRequest="60" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" TextColor="White" Text="{Binding PlayListName}" FontAttributes="Bold" VerticalOptions="End" Grid.Row="0" HorizontalOptions="Start"/>
                                <Label Grid.Row="1" TextColor="White" Grid.Column="1" VerticalOptions="Start" Text="{Binding CreatorName}" FontAttributes="Italic" />
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2" Text="Songs" TextColor="White" FontSize="24" FontAttributes="Bold" Margin="0,10,0,10"/>

        <CollectionView Grid.Row="3" 
                        ItemsSource="{Binding Songs}" 
                        HeightRequest="250" 
                        Margin="0,0,0,20">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <Border BackgroundColor="#332433" 
                            Margin="0,0,0,10" 
                            Stroke="LightGrey" 
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                
                        <Grid ColumnDefinitions="Auto, *" Padding="12" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSongTapped" />
                            </Grid.GestureRecognizers>

                            <Border StrokeShape="RoundRectangle 8" 
                                    StrokeThickness="2" 
                                    WidthRequest="50" 
                                    HeightRequest="50">
                                <Image Source="{Binding SongImage}" Aspect="AspectFill"/>
                            </Border>
                    
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0">
                                <Label Text="{Binding Title}" 
                                       TextColor="White" 
                                       FontSize="16" 
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding ArtistName}" 
                                       TextColor="#B8B8B8" 
                                       FontSize="13"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ContentView Grid.Row="4" />
    </Grid>
</ContentPage>