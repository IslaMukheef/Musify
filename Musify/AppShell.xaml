<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Musify.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Musify.Views"
    FlyoutBehavior="Disabled"
    BackgroundColor="#1B1B1B">

    <TabBar>
        <Tab Title="Home">
            <ShellContent ContentTemplate="{DataTemplate local:Home}" />
        </Tab>
        <Tab Title="Library">
            <ShellContent ContentTemplate="{DataTemplate local:LibraryView}" />
        </Tab>
        <Tab Title="Local">
            <ShellContent ContentTemplate="{DataTemplate local:LocalView}" />
        </Tab>
    </TabBar>

</Shell>