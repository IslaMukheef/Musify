<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Musify.ViewModels"
             x:Class="Musify.Views.Search"
             Title="Search"
             BackgroundColor="#121212"
             Loaded="OnPageLoaded"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.BindingContext>
        <viewModels:SearchViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20,48,20,20"
                             Spacing="16">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <SearchBar x:Name="SearchInputBar"
                           Placeholder="What do you want to listen to?"
                           BackgroundColor="#121212"
                           TextColor="White"
                           PlaceholderColor="#8C8C8C"
                           Text="{Binding SearchText}"
                           TextChanged="OnSearchTextChanged"
                           HorizontalOptions="Fill" />

                <Label Grid.Column="1"
                       Text="Cancel"
                       TextColor="White"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelButtonClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Label Text="Suggestions"
                   TextColor="White"
                   FontSize="18"
                   IsVisible="{Binding ShowSuggestions}" />

            <VerticalStackLayout IsVisible="{Binding ShowSuggestions}"
                                 Spacing="12">
                <Button Text="Michael Jackson"
                        Clicked="OnSuggestionClicked"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="17"
                        TextTransform="None"
                        HorizontalOptions="Start" />

                <Button Text="J. Cole"
                        Clicked="OnSuggestionClicked"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="17"
                        TextTransform="None"
                        HorizontalOptions="Start" />

                <Button Text="Taylor Swift"
                        Clicked="OnSuggestionClicked"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="17"
                        TextTransform="None"
                        HorizontalOptions="Start" />
            </VerticalStackLayout>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredSongs}"
                                 Spacing="12"
                                 IsVisible="{Binding ShowResults}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#332433"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResultTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12">
                                <Border StrokeThickness="0"
                                        WidthRequest="56"
                                        HeightRequest="56">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Image Source="{Binding SongImage}"
                                           Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           TextColor="White"
                                           FontSize="16"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding ArtistName}"
                                           TextColor="#D0D0D0"
                                           FontSize="13" />
                                    <Label Text="{Binding AlbumName}"
                                           TextColor="#9B9B9B"
                                           FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="No results found."
                   TextColor="#B8B8B8"
                   FontSize="16"
                   IsVisible="{Binding ShowNoResults}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
