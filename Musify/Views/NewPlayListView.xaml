<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musify.Views.NewPlayListView"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="black">
    <!--     new PlayList("Chill Vibes", 1,"dotnet_bot.png","Isla"), -->
    <Grid RowDefinitions="Auto, Auto, *"
                ColumnDefinitions="auto,*">
        <Label Text="Playlist name"
               Grid.Column="0"
               Grid.Row="0"
               TextColor="White"
               Margin="10"
               FontSize="18"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontAttributes="Bold"/>
        <Entry Grid.Column="1"
               Grid.Row="0"
               BackgroundColor="White"
               x:Name="NewTitle"
               Margin="10"/>
        <Label Text="Playlist Picture"
               Grid.Column="0"
               Grid.Row="1"
               TextColor="White"
               Margin="10"
               FontSize="18"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontAttributes="Bold"/>
        <ImageButton Grid.Column="1"
               Grid.Row="1"
               Source="{Binding PlaylistImage}"
               Aspect="AspectFit"
               HeightRequest="300"
               WidthRequest="300"
               Margin="10"
               Clicked="OnPickPhotoClicked"
               BackgroundColor="Gray"/>
        <Button Text="Create"
                Grid.Row="2"
                Grid.Column="0"
                Margin="10"
                VerticalOptions="Center"
                FontAttributes="Bold"
                HorizontalOptions="End"
                Clicked="OnCreateNewPlaylist"/>
        <Button Text="Back"
                Grid.Row="2"
                Grid.Column="1"
                Margin="10"
                FontAttributes="Bold"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Clicked="OnBackButtonClicked"/>
    </Grid>
</ContentPage>