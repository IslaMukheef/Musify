<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Musify.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Musify.Views"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <TabBar>
        <Tab Title="Home" Icon="home_navi_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:Home}" />
        </Tab>

        <Tab Title="Library" Icon="library_navi_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:LibraryView}" />
        </Tab>

        <Tab Title="Local" Icon="local_navi_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:LocalView}" />
        </Tab>
    </TabBar>

</Shell>