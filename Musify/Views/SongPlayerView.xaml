<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musify.Views.SongPlayerView"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" Padding="30,60,30,40">
        
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
            <ImageButton Source="back_icon.png" 
                         Clicked="OnBackClicked" 
                         WidthRequest="30" 
                         HeightRequest="30"
                         BackgroundColor="Transparent"/>
            <Label Grid.Column="1" 
                   Text="NOW PLAYING" 
                   TextColor="#B8B8B8" 
                   FontSize="12" 
                   CharacterSpacing="2" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"/>
            <ImageButton Grid.Column="2" 
                         Source="plus_icon.png" 
                         Clicked="OnAddToPlaylistClicked" 
                         WidthRequest="30" 
                         HeightRequest="30"
                         BackgroundColor="Transparent"/>
        </Grid>

        <Border Grid.Row="1" 
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                WidthRequest="320" 
                HeightRequest="320" 
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Image Source="{Binding SongImage}" Aspect="AspectFill"/>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="5" Margin="0,20">
            <Label Text="{Binding Title}" 
                   TextColor="White" 
                   FontSize="24" 
                   FontAttributes="Bold"/>
            <Label Text="{Binding ArtistName}" 
                   TextColor="#B8B8B8" 
                   FontSize="18">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnArtistTapped"/>
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="3" Spacing="10" HorizontalOptions="Fill">
            <Slider x:Name="PositionSlider"
                    MinimumTrackColor="{StaticResource Magenta}" 
                    MaximumTrackColor="#4A4A4A" 
                    ThumbColor="White"
                    DragStarted="OnSliderDragStarted"
                    DragCompleted="OnSliderDragCompleted"
                    HorizontalOptions="Fill"/> 
            
            <Grid ColumnDefinitions="*,*" HorizontalOptions="Fill">
                <Label x:Name="CurrentTimeLabel" 
                       Text="0:00" 
                       TextColor="#B8B8B8" 
                       FontSize="12"
                       HorizontalOptions="Start"/>
                <Label x:Name="TotalTimeLabel" 
                       Grid.Column="1"
                       Text="0:00" 
                       TextColor="#B8B8B8" 
                       FontSize="12" 
                       HorizontalOptions="End"/>
            </Grid>
        </VerticalStackLayout>

        <Grid Grid.Row="4" ColumnDefinitions="*, *, *" VerticalOptions="Center" Margin="0,30,0,0">
            <ImageButton Grid.Column="0" 
                         Source="skip_back.png" 
                         WidthRequest="40" 
                         HeightRequest="40" 
                         HorizontalOptions="Center"
                         BackgroundColor="Transparent"/>
            
            <ImageButton x:Name="PlayPauseBtn"
                         Grid.Column="1" 
                         Source="pause_circle.png" 
                         Clicked="OnPlayPauseClicked" 
                         WidthRequest="70" 
                         HeightRequest="70" 
                         HorizontalOptions="Center"
                         BackgroundColor="Transparent"/>
            
            <ImageButton Grid.Column="2" 
                         Source="skip_next.png" 
                         WidthRequest="40" 
                         HeightRequest="40" 
                         HorizontalOptions="Center"
                         BackgroundColor="Transparent"/>
        </Grid>

    </Grid>
</ContentPage>