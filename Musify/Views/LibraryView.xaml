<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musify.Views.LibraryView"
             xmlns:models="clr-namespace:Musify.Models"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" Padding="20,48,20,10">
        
        <Label Grid.Row="0" Text="Playlists" TextColor="White" FontSize="28" FontAttributes="Bold" Margin="0,0,0,10"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding playlist}" SelectionMode="Single" SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" Margin="0,0,0,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView>
                        <Border BackgroundColor="#332433" Margin="10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnViewPlayListTapped" NumberOfTapsRequired="1"/></Border.GestureRecognizers>
                            <Grid RowSpacing="0"> 
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 20" Margin="5,5,10,5" Grid.RowSpan="2" Grid.Column="0">
                                    <Image Source="{Binding PlayListImage}" Aspect="AspectFit" WidthRequest="80" HeightRequest="60" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" TextColor="White" Text="{Binding PlayListName}" FontAttributes="Bold" VerticalOptions="End" Grid.Row="0" HorizontalOptions="Start"/>
                                <Label Grid.Row="1" TextColor="White" Grid.Column="1" VerticalOptions="Start" Text="{Binding CreatorName}" FontAttributes="Italic" />
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2" Text="Songs" TextColor="White" FontSize="24" FontAttributes="Bold" Margin="0,0,0,5"/>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Songs}" HeightRequest="180" Margin="0,0,0,40">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <Grid ColumnDefinitions="Auto, *" Padding="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSongTapped" />
                        </Grid.GestureRecognizers>
                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0">
                            <Image Source="{Binding SongImage}" WidthRequest="45" HeightRequest="45" Aspect="AspectFill"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0">
                            <Label Text="{Binding Title}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                            <Label Text="{Binding ArtistName}" TextColor="#B8B8B8" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="4" HorizontalOptions="Center" Spacing="20" Padding="0,10">
            <Button Text="New" Clicked="OnNewClicked" WidthRequest="100" HeightRequest="45" BackgroundColor="{StaticResource Magenta}" TextColor="White" CornerRadius="14"/>
            <Button Text="Edit" Clicked="OnPlayListEditClicked" WidthRequest="100" HeightRequest="45" BackgroundColor="{StaticResource Magenta}" TextColor="White" CornerRadius="14"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>